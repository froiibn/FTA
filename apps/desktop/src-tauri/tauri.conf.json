{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FTA",
  "version": "0.1.5",
  "identifier": "app.fta.local-transfer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FTA \u00b7 \ub0b4 \uae30\uae30\ub85c \ubcf4\ub0b4\uae30",
        "width": 280,
        "height": 260,
        "minWidth": 240,
        "minHeight": 230,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#171b20",
        "decorations": false
      },
      {
        "label": "inbox",
        "title": "FTA \u00b7 \uae30\ub85d",
        "url": "index.html?view=inbox",
        "create": false,
        "width": 600,
        "height": 520,
        "minWidth": 380,
        "minHeight": 320,
        "theme": "Dark",
        "backgroundColor": "#171b20",
        "dragDropEnabled": false,
        "decorations": false
      },
      {
        "label": "settings",
        "title": "FTA \u00b7 \uc124\uc815",
        "url": "index.html?view=settings",
        "create": false,
        "width": 520,
        "height": 640,
        "minWidth": 380,
        "minHeight": 400,
        "theme": "Dark",
        "backgroundColor": "#171b20",
        "dragDropEnabled": false,
        "decorations": false
      },
      {
        "label": "detail",
        "title": "FTA \u00b7 \uc218\uc2e0 \ub0b4\uc6a9",
        "url": "index.html?view=detail",
        "create": false,
        "width": 640,
        "height": 520,
        "minWidth": 380,
        "minHeight": 320,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#171b20",
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "fta"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QzhCMUY5MjY5NDdDOTIKUldTU2ZKUW0rYkhJZE1pWnJRRlVZUmZyTGhEUHBCdzFiV1UyemV1YXVuZ1BUd251MVlqQmNDSlIK",
      "endpoints": [
        "https://github.com/froiibn/FTA/releases/latest/download/latest-{{target}}-{{arch}}.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
