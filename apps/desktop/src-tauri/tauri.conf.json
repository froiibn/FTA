{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FTA",
  "version": "0.1.1",
  "identifier": "app.fta.local-transfer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FTA · 내 기기로 보내기",
        "width": 280,
        "height": 260,
        "minWidth": 240,
        "minHeight": 230,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#171b20",
        "decorations": false
      },
      {
        "label": "inbox",
        "title": "FTA · 기록",
        "url": "index.html?view=inbox",
        "create": false,
        "width": 600,
        "height": 520,
        "minWidth": 380,
        "minHeight": 320,
        "theme": "Dark",
        "backgroundColor": "#171b20",
        "dragDropEnabled": false,
        "decorations": false
      },
      {
        "label": "settings",
        "title": "FTA · 설정",
        "url": "index.html?view=settings",
        "create": false,
        "width": 520,
        "height": 640,
        "minWidth": 380,
        "minHeight": 400,
        "theme": "Dark",
        "backgroundColor": "#171b20",
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "fta"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
